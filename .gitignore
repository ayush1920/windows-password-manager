# ==========================================================
# .gitignore - KeyCraft Password & Credential Manager
# ==========================================================

# ----------------------------------------------------------
# Temporary Cache, Scratch & Screenshots (NEVER POISON ROOT)
# ----------------------------------------------------------
.cache/
temp/
tmp/
scratch/
/*.png
/*.jpg
/*.jpeg
/*.bmp
screenshot*.png
*.screenshot.png
!assets/**

# ----------------------------------------------------------
# Temporary Debug, Scratch & Capture Scripts
# ----------------------------------------------------------
scripts/capture_*
scripts/debug_*
scripts/scratch_*
scripts/temp_*
scripts/test_dock.ps1
scripts/test_shadow.ps1
test_*.ps1
scratch_*.ps1
diag_*.ps1

# ----------------------------------------------------------
# Python Caches & Environments
# ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# ----------------------------------------------------------
# CRITICAL: Credentials, Settings & Backups (NEVER COMMIT)
# ----------------------------------------------------------
data/
credentials.txt
*.credentials
*.credential
passwords.txt
secrets.txt
secrets.json
*.key
*.kcrypt
*.kcrypt.bak
*.bak
*.tmp
*.conf
*.user_backup_*

# ----------------------------------------------------------
# Logs & Diagnostic Dumps
# ----------------------------------------------------------
*.log
logs/
crash.log
err.log
out.log
*.dmp
*.mdmp

# ----------------------------------------------------------
# Build Outputs & Executables
# ----------------------------------------------------------
bin/
obj/
build/
*.exe
*.dll
*.pdb
*.obj
*.ilk
*.exp
*.lib
TestResults/

# ----------------------------------------------------------
# IDE & Visual Studio / JetBrains Files
# ----------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.DotSettings.user

# ----------------------------------------------------------
# OS Metadata
# ----------------------------------------------------------
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
